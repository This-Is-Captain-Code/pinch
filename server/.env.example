# ── Stackchan bounty agent ──────────────────────────────────────────
# Copy to .env and fill in. Generate a wallet with: npm run gen-wallet

# The robot's agentic wallet (server-custodied). 0x-prefixed 32-byte hex.
# This account holds MON and pays the human who solves a bounty.
AGENT_PRIVATE_KEY=

# Monad testnet (chain id 10143). Override for mainnet if you ever go live.
RPC_URL=https://testnet-rpc.monad.xyz
CHAIN_ID=10143
EXPLORER_URL=https://testnet.monadscan.com

# Bounty reward per obstruction, in MON.
REWARD_MON=0.05

# HTTP API / operator page.
PORT=8090

# ── MQTT (optional) ─────────────────────────────────────────────────
# Leave MQTT_URL empty to run without the broker (use the /api/sim/*
# endpoints or the operator page buttons to drive the loop by hand).
# To listen to the real robot, point at the broker it publishes to.
MQTT_URL=
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=stackchan-bounty-agent
# The device hash (mqtt.hash() on the robot). Leave empty to listen to
# all devices (og/d/+/commands).
DEVICE_HASH=

# ── Teleop (WebXR hand-tracking -> motor) ───────────────────────────
# The server subscribes to the hand-tracking relay and forwards pan/tilt to
# the robot over MQTT cmd. Control only reaches a device whose bounty is
# CLAIMED (set TELEOP_DEVICE_HASH to bypass that gate while testing).
TELEOP_ENABLED=true
RELAY_WS_URL=wss://pinch-relay.jenil-panchal10.workers.dev/ws
TELEOP_HZ=8
TELEOP_HAND=right
TELEOP_JOINT=0            # 0=wrist, 10=index fingertip
TELEOP_DEVICE_HASH=
# Hand position (metres, local frame) mapped onto 0..180 servo range — tune to taste.
TELEOP_PAN_IN_MIN=-0.3
TELEOP_PAN_IN_MAX=0.3
TELEOP_TILT_IN_MIN=-0.3
TELEOP_TILT_IN_MAX=0.3
TELEOP_PAN_INVERT=false
TELEOP_TILT_INVERT=true
