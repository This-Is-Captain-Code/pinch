# Base URL of the stackchan bounty agent server (the /server app, hosted on Render).
# Copy to .env.local for dev, and set the same var in Vercel project settings.
# Must be set at BUILD time — Next.js inlines NEXT_PUBLIC_* into the client bundle.
# Leave unset to run the UI on mock data only.
NEXT_PUBLIC_API_URL=http://localhost:8090

# The WebXR teleop page (openxr). Clicking a bounty on the bounties grid
# sends the operator here to steer the robot. Quests do NOT use this.
NEXT_PUBLIC_WEBXR_URL=https://openxr-ashen.vercel.app
